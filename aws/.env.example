# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# Job posting URLs to watch, comma-separated
JOB_URLS=https://www.google.com/about/careers/applications/jobs/results/120686451305128646-software-developer-early-career-campus

# Spectrum Cloud credentials (Photon dashboard -> project Settings,
# https://app.photon.codes)
PROJECT_ID=
PROJECT_SECRET=

# Who gets the iMessage alerts — E.164 numbers, comma-separated.
# Each number must be registered as a project user on the Photon
# dashboard (shared-pool plan requirement).
RECIPIENTS=+15557654321,+15551112222,+15553334444,+15556667777

# Optional email alerts via SES. EMAIL_FROM must be a verified SES
# identity; sending to unverified recipients needs SES production
# access. Leave blank to disable.
EMAIL_FROM=
EMAIL_TO=
