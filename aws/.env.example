# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# Job posting URLs to watch, comma-separated
JOB_URLS=https://www.google.com/about/careers/applications/jobs/results/120686451305128646-software-developer-early-career-campus

# From https://console.twilio.com  (Account Info panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Your Twilio number (buy one in the console, ~$1/mo) and the team's
# cells — comma-separated, everyone listed gets every alert
TWILIO_FROM=+15551234567
TWILIO_TO=+15557654321,+15551112222,+15553334444,+15556667777
